# Base URL of the backend API. Leave empty for local development: the app then talks to
# http://localhost:8000, which is where `just dev` in ../backend listens.
#
# The Vite dev server runs on http://localhost:3000 (vite.config.ts) because that is the one
# origin the backend allows by default (CORS_ORIGINS in backend/app/core/config.py). Change the
# port here and there together.
VITE_API_BASE_URL=
