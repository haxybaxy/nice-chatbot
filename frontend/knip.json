{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/features/*/index.ts",
    "src/shared/components/ui/*.tsx",
    "src/shared/components/ai-elements/*.tsx",
    "src/shared/hooks/use-mobile.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["shadcn", "tw-animate-css", "tailwindcss"],
  "vite": true,
  "vitest": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
