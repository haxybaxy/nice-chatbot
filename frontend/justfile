# List all recipes
default:
    @just --list

# Install dependencies exactly as locked
install:
    npm ci

# Start the Vite dev server on :3000 (the backend's default CORS origin)
dev:
    npm run dev

# Production build into dist/
build:
    npm run build

# Serve the production build locally
preview:
    npm run preview

# Format with prettier
fmt:
    npm run format

# Lint and auto-fix with eslint (warnings fail)
lint:
    npx eslint . --max-warnings=0 --fix

# Type check with tsc (strict)
typecheck:
    npm run typecheck

# Dead-code scan with knip (unused files, exports, dependencies)
deadcode:
    npm run deadcode

# Duplication scan with jscpd (report in claudedocs/jscpd)
dup:
    npm run dup

# Fail on circular imports (madge)
cycles:
    npm run graph:circular

# Dead code · duplication · complexity · architecture boundaries in one pass (fallow, .fallowrc.json)
fallow:
    npm run fallow

# Run every quality gate
check: fmt lint typecheck deadcode dup cycles fallow contract-check

# Run the test suite once (pass extra vitest args, e.g. `just test -t "refresh"`)
test *args:
    npx vitest run {{ args }}

# Run the test suite in watch mode
watch:
    npm run test

# Run the test suite with a coverage report
cov:
    npm run coverage

# What CI runs: non-mutating checks + tests
ci:
    npm run format:check
    npm run lint
    just typecheck deadcode dup cycles fallow contract-check
    npm run test:run

# `yes n` answers shadcn's "file already exists, overwrite?" prompts (`--yes` does not cover them)
# so an already-vendored dependency such as button.tsx is kept and the remaining files still land.

# Add shadcn components (e.g. `just ui-add dialog select`); rewrites their `cn` import to @/shared/utils
ui-add *components:
    yes n | npx shadcn@latest add {{ components }} --yes
    just _normalize-registry-files

# The registry targets `components/ai-elements/` literally (not the `components` alias), so the
# files land in src/components/ and are moved under src/shared/ before normalizing.

# Add Vercel AI Elements (e.g. `just ai-add conversation message`) into src/shared/components/ai-elements/, normalized like `ui-add`
ai-add *components:
    for c in {{ components }}; do yes n | npx shadcn@latest add --yes "https://elements.ai-sdk.dev/api/registry/$c.json"; done
    mkdir -p src/shared/components/ai-elements
    if [ -d src/components/ai-elements ]; then mv src/components/ai-elements/* src/shared/components/ai-elements/ && rm -r src/components; fi
    just _normalize-registry-files

# shadcn 4 writes `import { cn } from "cn"` (its own package) and pulls `next-themes`; keep one `cn`.
_normalize-registry-files:
    sed -i '' -e 's#from "cn"#from "@/shared/utils"#' -e 's#from "@/shared/utils/index"#from "@/shared/utils"#' src/shared/components/ui/*.tsx src/shared/components/ai-elements/*.tsx
    npm uninstall cn next-themes --no-audit --no-fund
    npx prettier --write src/shared/components/ui src/shared/components/ai-elements src/shared/hooks --log-level warn --no-error-on-unmatched-pattern

# THE command after any backend API change: ../backend `just openapi-snapshot` -> copy the snapshot to
# src/test/contract/openapi.json -> openapi-typescript. Commit all three generated files together.
contract-refresh:
    npm run contract:refresh

# Non-mutating: openapi.json == backend snapshot and schema.d.ts == generator(openapi.json). Node only, no uv.
contract-check:
    npm run contract:check

# Regenerate only the wire types from the committed snapshot
types:
    npm run types:generate
