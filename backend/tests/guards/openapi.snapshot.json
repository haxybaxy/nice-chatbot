        ],
        "title": "OrganizationMemberOut",
        "type": "object"
      },
      "OrganizationOut": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ],
        "title": "OrganizationOut",
        "type": "object"
      },
      "OrganizationRole": {
        "description": "Stored as a plain string column (with a CHECK), so adding a value is a code change\nplus a migration of the constraint \u2014 no ``ALTER TYPE``.",
        "enum": [
          "owner",
          "admin",
          "member"
        ],
        "title": "OrganizationRole",
        "type": "string"
      },
      "ReadinessOut": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessOut",
        "type": "object"
      },
      "RefreshIn": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "maxLength": 8192,
            "title": "Refreshtoken",
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "title": "RefreshIn",
        "type": "object"
      },
      "ResetPasswordIn": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPasswordIn",
        "type": "object"
      },
      "SignInIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInIn",
        "type": "object"
      },
      "SignUpIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          },
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpIn",
        "type": "object"
      },
      "SignUpOut": {
        "description": "The new user, the personal organization and default team created with them, and a session.",
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/AuthOrganizationOut"
          },
          "team": {
            "$ref": "#/components/schemas/AuthTeamOut"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokensOut"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserOut"
          }
        },
        "required": [
          "user",
          "organization",
          "team",
          "tokens"
        ],
        "title": "SignUpOut",
        "type": "object"
      },
      "TokensOut": {
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          },
          "tokenType": {
            "const": "bearer",
            "default": "bearer",
            "title": "Tokentype",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ],
        "title": "TokensOut",
        "type": "object"
      },
      "UpdateUserIn": {
        "additionalProperties": false,
        "properties": {
          "fullName": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          }
        },
        "title": "UpdateUserIn",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
