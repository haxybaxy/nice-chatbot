            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "AuthOrganizationOut",
        "type": "object"
      },
      "AuthTeamOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "AuthTeamOut",
        "type": "object"
      },
      "AuthUserOut": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ],
        "title": "AuthUserOut",
        "type": "object"
      },
      "CreateOrganizationIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateOrganizationIn",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Machine-readable cause on the JSON error envelope (``ErrorOut.code``).",
        "enum": [
          "BAD_REQUEST",
          "AUTH_FAILED",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VALIDATION_ERROR",
          "HTTP_ERROR",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorOut": {
        "description": "The one JSON error envelope \u2014 built by ``app/core/exception_handlers.py`` and declared on\nevery route's error responses through ``app.core.openapi.error_responses``.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "statusCode": {
            "title": "Statuscode",
            "type": "integer"
          }
        },
        "required": [
          "error",
          "code",
          "statusCode",
          "correlationId"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "ForgotPasswordIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordIn",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "InviteMemberIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole",
            "default": "member"
          }
        },
        "required": [
          "email"
        ],
        "title": "InviteMemberIn",
        "type": "object"
      },
      "MemberUserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "fullName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
