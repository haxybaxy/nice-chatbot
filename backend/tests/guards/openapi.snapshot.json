            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          },
          "user": {
            "$ref": "#/components/schemas/MemberUserOut"
          },
          "userId": {
            "format": "uuid",
            "title": "Userid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "role",
          "createdAt",
