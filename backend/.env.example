# Every variable here is a field on one of the settings classes (backend/app/core/config.py and
# backend/app/db/config.py); tests/guards/test_settings.py keeps the two in sync. The process
# environment outranks this file.

# ── Settings (app/core/config.py) ─────────────────────────────────────────────
# Deploy tier. Drives log format and whether /docs + error details are exposed:
#   local | test        → console logs, /docs on, error details in responses
#   develop | staging   → JSON logs, /docs on, error details in responses
#   prod | production   → JSON logs, /docs off, error details masked
# Any other value refuses to start.
ENVIRONMENT=local
PROJECT_NAME=Nice Chatbot API
# VERSION=0.1.0
# Where the SPA is served (no trailing slash); password-reset links point at it.
# FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
# LOG_FORMAT=auto            # auto (console locally, JSON when deployed) | json | console

# CORS — a JSON list of explicit origins ("*" is rejected: the API allows credentials)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── DatabaseSettings (app/db/config.py) ───────────────────────────────────────
# PostgreSQL (psycopg 3 async driver). Credentials must match docker.env for the local container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nicechatbot
# The test suite drops and rebuilds the schema of THIS database at session start — it must
# never point at the dev database above. Created by docker-init/01-create-test-db.sql.
# (Read by tests/conftest.py, not by the app.)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nicechatbot_test

# Connection pool (per process)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_S=30
# DB_STATEMENT_TIMEOUT_MS=30000

# ── AwsSettings (app/core/config.py) ──────────────────────────────────────────
# Static credentials for boto3, shared by the Cognito and SES adapters. Optional: when unset, boto3
# resolves them from the PROCESS environment or an IAM role — not from this file — so locally run
# `AWS_PROFILE=nicechatbot just dev`. The identity needs the cognito-idp actions listed below and
# ses:SendEmail on the sending identity (infra/ grants both).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Mail has no variables: the SES sender (noreply@example.com) and region are fixed in code —
# MailSettings in app/core/config.py.

# ── CognitoSettings (app/core/config.py) ──────────────────────────────────────
# The Cognito user pool lives in AWS_REGION (the develop pool from infra/ is in us-west-1).
AWS_REGION=us-west-1

# AWS Cognito — `just backend-env` in infra/ prints these for the develop pool. The pool must use
# email as the username. The app client must be PUBLIC (no secret) with
# ALLOW_ADMIN_USER_PASSWORD_AUTH and ALLOW_REFRESH_TOKEN_AUTH enabled. The AWS identity above needs
# cognito-idp:AdminCreateUser, AdminSetUserPassword, AdminDeleteUser, AdminInitiateAuth and
# AdminUserGlobalSignOut on the pool (GlobalSignOut is authorized by the user's access token, not IAM).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only for a confidential app client; SECRET_HASH is computed automatically when set.
# COGNITO_CLIENT_SECRET=

# ── ChatSettings (app/core/config.py) ─────────────────────────────────────────
# Per-run limits for the chat worker and the SSE endpoint.
# CHAT_RUN_TIMEOUT_S=900
# CHAT_HISTORY_MAX_MESSAGES=60
# CHAT_SSE_PING_INTERVAL_S=15
# CHAT_TITLE_TIMEOUT_S=10

# ── WorkerSettings (app/core/config.py) ───────────────────────────────────────
# The run worker (`just worker` / `python -m app.worker`).
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL_S=5
# WORKER_HEARTBEAT_INTERVAL_S=2
# WORKER_STALE_AFTER_S=30
# WORKER_REAPER_INTERVAL_S=15
# WORKER_EVENT_FLUSH_MS=75
# WORKER_SHUTDOWN_GRACE_S=20

# ── AttachmentSettings (app/core/config.py) ───────────────────────────────────
# File attachments on chat messages (bytes are stored in Postgres, text is extracted at upload).
# ATTACHMENT_MAX_BYTES=10485760
# ATTACHMENT_MAX_PER_MESSAGE=5
# ATTACHMENT_MAX_EXTRACTED_CHARS=200000
# ATTACHMENT_MODEL_TEXT_CHARS=60000
# ATTACHMENT_ORPHAN_TTL_HOURS=24

# ── LlmSettings (app/core/config.py) ──────────────────────────────────────────
# Claude through the Anthropic API (required for the default models).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# Any OpenAI-compatible server (vLLM, Ollama, an unsloth-served model): setting the base URL
# enables the "openai" provider; the key is whatever the server expects (Ollama ignores it).
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# The model picker, as a JSON list of "<provider>:<model-id>" (never date-suffixed ids).
# LLM_MODELS=["anthropic:claude-opus-5-5","anthropic:claude-sonnet-5-5","anthropic:claude-haiku-5-5","openai:llama3.3"]
# LLM_DEFAULT_MODEL=anthropic:claude-opus-5-5
# LLM_TITLE_MODEL=anthropic:claude-haiku-5-5
# LLM_DEFAULT_EFFORT=medium        # low | medium | high | xhigh | max
# LLM_MAX_TOKENS=64000
# LLM_REQUEST_TIMEOUT_S=600
# LLM_MAX_RETRIES=2
# Capabilities of the OpenAI-compatible server.
# LLM_OPENAI_SUPPORTS_TOOLS=true
# LLM_OPENAI_SUPPORTS_REASONING=false
# LLM_OPENAI_SUPPORTS_VISION=false        # image attachments as content blocks (Claude always can)
# LLM_OPENAI_PARALLEL_TOOL_CALLS=false
# LLM_OPENAI_MAX_TOKENS_PARAM=max_completion_tokens   # max_completion_tokens | max_tokens

# ── AgentSettings (app/core/config.py) ────────────────────────────────────────
# LangGraph checkpointing: postgres (own schema, crash-resume) | none (tests).
# AGENT_CHECKPOINTER=postgres
# AGENT_CHECKPOINT_SCHEMA=langgraph
# AGENT_MAX_MODEL_CALLS=12
# AGENT_MAX_TOOL_CALLS=24
# AGENT_MAX_TOOL_CALLS_PER_STEP=8

# ── SearchSettings (app/core/config.py) ───────────────────────────────────────
# Tavily powers web_search / web_fetch. Unset → the web tools are not offered.
# TAVILY_API_KEY=
# SEARCH_MAX_CONCURRENCY=8
# SEARCH_TIMEOUT_S=30

# ── SandboxSettings (app/core/config.py) ──────────────────────────────────────
# run_code backend: docker (throwaway container per execution; needs the Docker socket — local
# development only) | disabled (tool hidden).
# SANDBOX_BACKEND=disabled
# SANDBOX_IMAGE=python:3.13-slim
# SANDBOX_TIMEOUT_S=30
# SANDBOX_MAX_TIMEOUT_S=120
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
# SANDBOX_PIDS_LIMIT=128
# SANDBOX_MAX_OUTPUT_BYTES=65536

# ── ResearchSettings (app/core/config.py) ─────────────────────────────────────
# Deep-research budgets.
# RESEARCH_MAX_SUBAGENTS=5
# RESEARCH_MAX_PARALLEL=3
# RESEARCH_MAX_TOOL_CALLS_PER_SUBAGENT=12
# RESEARCH_MAX_OUTPUT_TOKENS_PER_SUBAGENT=16000
# RESEARCH_TOTAL_TOKEN_BUDGET=400000
# RESEARCH_WALL_CLOCK_S=600
# RESEARCH_CITATION_CHECK=true

# ── LangfuseSettings (app/core/config.py) ─────────────────────────────────────
# Tracing of every run, model call and tool call. Both keys unset → no-op.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true
