# Every variable here is a field on one of the settings classes (backend/app/core/config.py and
# backend/app/db/config.py); tests/guards/test_settings.py keeps the two in sync. The process
# environment outranks this file.

# ── Settings (app/core/config.py) ─────────────────────────────────────────────
# Deploy tier. Drives log format and whether /docs + error details are exposed:
#   local | test        → console logs, /docs on, error details in responses
#   develop | staging   → JSON logs, /docs on, error details in responses
#   prod | production   → JSON logs, /docs off, error details masked
# Any other value refuses to start.
ENVIRONMENT=local
PROJECT_NAME=Acme API
# VERSION=0.1.0
# Where the SPA is served (no trailing slash); password-reset links point at it.
# FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
# LOG_FORMAT=auto            # auto (console locally, JSON when deployed) | json | console

# CORS — a JSON list of explicit origins ("*" is rejected: the API allows credentials)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── DatabaseSettings (app/db/config.py) ───────────────────────────────────────
# PostgreSQL (psycopg 3 async driver). Credentials must match docker.env for the local container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/acme
# The test suite drops and rebuilds the schema of THIS database at session start — it must
# never point at the dev database above. Created by docker-init/01-create-test-db.sql.
# (Read by tests/conftest.py, not by the app.)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/acme_test

# Connection pool (per process)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_S=30
# DB_STATEMENT_TIMEOUT_MS=30000

# ── AwsSettings (app/core/config.py) ──────────────────────────────────────────
# Static credentials for boto3, shared by the Cognito and SES adapters. Optional: when unset, boto3
# resolves them from the PROCESS environment or an IAM role — not from this file — so locally run
# `AWS_PROFILE=acme just dev`. The identity needs the cognito-idp actions listed below and
# ses:SendEmail on the sending identity (infra/ grants both).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Mail has no variables: the SES sender (noreply@example.com) and region are fixed in code —
# MailSettings in app/core/config.py.

# ── CognitoSettings (app/core/config.py) ──────────────────────────────────────
# The Cognito user pool lives in AWS_REGION (the develop pool from infra/ is in us-west-1).
AWS_REGION=us-west-1

# AWS Cognito — `just backend-env` in infra/ prints these for the develop pool. The pool must use
# email as the username. The app client must be PUBLIC (no secret) with
# ALLOW_ADMIN_USER_PASSWORD_AUTH and ALLOW_REFRESH_TOKEN_AUTH enabled. The AWS identity above needs
# cognito-idp:AdminCreateUser, AdminSetUserPassword, AdminDeleteUser, AdminInitiateAuth and
# AdminUserGlobalSignOut on the pool (GlobalSignOut is authorized by the user's access token, not IAM).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only for a confidential app client; SECRET_HASH is computed automatically when set.
# COGNITO_CLIENT_SECRET=
